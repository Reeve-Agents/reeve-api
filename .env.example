# Default SOP parser: fixture (offline) | anthropic | anthropic:claude-haiku-5-5 | openrouter | gemini | groq | deepseek | openai | ollama | custom
# Every parser set up below stays selectable per SOP in the studio.
REEVE_LLM=fixture
# With REEVE_LLM=anthropic: claude-opus-5-5 (default) | claude-sonnet-5-5 | claude-haiku-5-5
# REEVE_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=

# Cheaper or free parsers (OpenAI-compatible). Set the key and the model id exactly as the service lists it.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GROQ_API_KEY=
# GROQ_MODEL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Ollama on this computer: no key; the SOP never leaves the machine
# OLLAMA_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Any other OpenAI-compatible server (LM Studio, Together, vLLM, ...)
# REEVE_OPENAI_BASE_URL=
# REEVE_OPENAI_MODEL=
# REEVE_OPENAI_API_KEY=

# Where generated code runs: local (dev only, no isolation) | createos
REEVE_SANDBOX=local
# CreateOS Sandbox API key — only needed for REEVE_SANDBOX=createos.
# Either a key from https://createos.sh/app/profile, or the one Stripe Projects writes
# (`stripe projects add createos/project` → CREATEOS_PROJECT_API_KEY). Both are accepted.
# CREATEOS_API_KEY=
# CREATEOS_PROJECT_API_KEY=

# Output directory for runs, receipts and the ledger
REEVE_HOME=
# Deployed: keep the store and the ledger in Postgres instead (run a single replica)
# DATABASE_URL=
# The web app's public origin; passkeys are bound to its hostname
# REEVE_WEB_ORIGIN=
# REEVE_API_PORT=.reeve

# Payment rails for "Run" (test mode only; live keys are refused)
# Stripe: Dashboard → Developers → API keys (test mode)
# STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:8787/api/webhooks/stripe` (optional; without it Reeve polls)
# STRIPE_WEBHOOK_SECRET=whsec_...
# Xendit: Dashboard in Test mode → Settings → API keys (write access to Payment Sessions and Refunds)
# XENDIT_SECRET_KEY=xnd_development_...
# Dashboard → Webhooks → verification token (optional; without it Reeve polls)
# XENDIT_WEBHOOK_TOKEN=

# Connectors for "Any SOP" (generic rules): where actions go and records come from. Keys stay in the broker.
# Composio: 1,500+ toolkits (WhatsApp, Gmail, Sheets, Slack, Shopify, ...). Free Hobby tier at composio.dev
# COMPOSIO_API_KEY=
# Whose connected accounts act (the owner's WhatsApp, Gmail, ...); default reeve-owner
# COMPOSIO_USER_ID=
# Any MCP server for systems Composio lacks (Moka, Jurnal, Accurate, a marketplace): JSON list
# REEVE_MCP_SERVERS=[{"name":"moka","url":"https://example.com/mcp","headers":{"Authorization":"Bearer ..."}}]

# On-chain anchor of the ledger's Merkle roots (proof only; testnets only: monad-testnet | base-sepolia).
# Create the wallet with `npm run anchor:wallet` (writes these two lines; the key is never printed),
# fund the printed address from the testnet faucet, then `npm run anchor:now` or POST /api/ledger/anchor.
# REEVE_ANCHOR_CHAIN=monad-testnet
# REEVE_ANCHOR_PRIVATE_KEY=
# REEVE_ANCHOR_RPC_URL=
